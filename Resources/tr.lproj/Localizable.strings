/* MARK: Cache descriptions */
"A self-contained Rust compiler, Cargo registry, and tools. Removing it does not delete source code, but the full toolchain must be installed again." = "Kendi içinde bütün bir Rust derleyicisi, Cargo kayıt defteri ve araçlar. Silmek kaynak kodu silmez, ancak araç zincirinin tamamı yeniden kurulmalıdır.";
"A separate downloaded Copilot CLI runtime channel. Local sessions and configuration under ~/.copilot are not targeted." = "İndirilmiş ayrı bir Copilot CLI çalışma zamanı kanalı. ~/.copilot altındaki yerel oturumlar ve yapılandırma hedeflenmez.";
"AWS SSO login tokens and temporary credential cache. Re-generates on next aws sso login." = "AWS SSO oturum belirteçleri ve geçici kimlik bilgisi önbelleği. Bir sonraki aws sso login komutunda yeniden oluşur.";
"Android Virtual Devices and disk images. Must re-create in AVD Manager." = "Android Sanal Aygıtları ve disk imajları. AVD Manager'da yeniden oluşturulmalıdır.";
"Arc's macOS cache container; spaces and profiles are not targeted." = "Arc'ın macOS önbellek kapsayıcısı; alanlar ve profiller hedeflenmez.";
"Archived builds for App Store or distribution. Re-archive from Xcode to recreate." = "App Store veya dağıtım için arşivlenmiş derlemeler. Yeniden oluşturmak için Xcode'dan tekrar arşivleyin.";
"Bambu Studio's embedded web cache; projects and printer settings are not targeted." = "Bambu Studio'nun gömülü web önbelleği; projeler ve yazıcı ayarları hedeflenmez.";
"Bazel build and repository caches. Re-populates on next bazel build." = "Bazel derleme ve depo önbellekleri. Bir sonraki bazel build komutunda yeniden dolar.";
"Blender's macOS cache container; blend files and preferences are not targeted." = "Blender'ın macOS önbellek kapsayıcısı; blend dosyaları ve tercihler hedeflenmez.";
"Browser packages downloaded by Playwright for Go. Re-downloads when the matching Playwright Go version installs its driver." = "Playwright for Go tarafından indirilen tarayıcı paketleri. İlgili Playwright Go sürümü sürücüsünü kurduğunda yeniden iner.";
"Build products, indexes, and logs. Rebuilds automatically when you open a project." = "Derleme çıktıları, dizinler ve günlükler. Bir projeyi açtığınızda otomatik olarak yeniden oluşur.";
"Cached Brave Beta web resources; browser profile data is not targeted." = "Önbelleğe alınmış Brave Beta web kaynakları; tarayıcı profil verileri hedeflenmez.";
"Cached Brave Nightly web resources; browser profile data is not targeted." = "Önbelleğe alınmış Brave Nightly web kaynakları; tarayıcı profil verileri hedeflenmez.";
"Cached Brave web resources; browser profile data is not targeted." = "Önbelleğe alınmış Brave web kaynakları; tarayıcı profil verileri hedeflenmez.";
"Cached Bun packages. Re-downloads on bun install." = "Önbelleğe alınmış Bun paketleri. bun install ile yeniden iner.";
"Cached Chrome Canary web resources; browser profile data is not targeted." = "Önbelleğe alınmış Chrome Canary web kaynakları; tarayıcı profil verileri hedeflenmez.";
"Cached Chrome web resources; browser profile data is not targeted." = "Önbelleğe alınmış Chrome web kaynakları; tarayıcı profil verileri hedeflenmez.";
"Cached Chromium web resources; browser profile data is not targeted." = "Önbelleğe alınmış Chromium web kaynakları; tarayıcı profil verileri hedeflenmez.";
"Cached Conda environments and packages. Re-downloads on conda install." = "Önbelleğe alınmış Conda ortamları ve paketleri. conda install ile yeniden iner.";
"Cached Dart/Flutter packages. Re-downloads on flutter pub get." = "Önbelleğe alınmış Dart/Flutter paketleri. flutter pub get ile yeniden iner.";
"Cached Deno modules and compiled scripts. Re-downloads on deno run." = "Önbelleğe alınmış Deno modülleri ve derlenmiş betikler. deno run ile yeniden iner.";
"Cached Edge Beta web resources; browser profile data is not targeted." = "Önbelleğe alınmış Edge Beta web kaynakları; tarayıcı profil verileri hedeflenmez.";
"Cached Edge Dev web resources; browser profile data is not targeted." = "Önbelleğe alınmış Edge Dev web kaynakları; tarayıcı profil verileri hedeflenmez.";
"Cached Edge web resources; browser profile data is not targeted." = "Önbelleğe alınmış Edge web kaynakları; tarayıcı profil verileri hedeflenmez.";
"Cached Opera web resources; browser profile data is not targeted." = "Önbelleğe alınmış Opera web kaynakları; tarayıcı profil verileri hedeflenmez.";
"Cached PHP packages. Re-downloads on composer install." = "Önbelleğe alınmış PHP paketleri. composer install ile yeniden iner.";
"Cached Poetry dependencies and wheels. Re-downloads on poetry install." = "Önbelleğe alınmış Poetry bağımlılıkları ve wheel dosyaları. poetry install ile yeniden iner.";
"Cached Python packages from uv (fast pip alternative). Re-downloads on uv pip install." = "uv (hızlı pip alternatifi) tarafından önbelleğe alınmış Python paketleri. uv pip install ile yeniden iner.";
"Cached Vivaldi web resources; browser profile data is not targeted." = "Önbelleğe alınmış Vivaldi web kaynakları; tarayıcı profil verileri hedeflenmez.";
"Cached Yarn packages. Re-downloads on yarn install." = "Önbelleğe alınmış Yarn paketleri. yarn install ile yeniden iner.";
"Cached crate sources and registries. Re-downloads on cargo build." = "Önbelleğe alınmış crate kaynakları ve kayıt defterleri. cargo build ile yeniden iner.";
"Cached package tarballs from npmjs.org. Re-downloads on npm install." = "npmjs.org'dan önbelleğe alınmış paket arşivleri. npm install ile yeniden iner.";
"Carthage dependency build cache. Re-downloads on carthage update." = "Carthage bağımlılık derleme önbelleği. carthage update ile yeniden iner.";
"ChatGPT Desktop app data. Conversations sync to cloud." = "ChatGPT Desktop uygulama verisi. Konuşmalar buluta eşitlenir.";
"Chromium disk cache used by VS Code. Safe to delete, rebuilds on launch." = "VS Code'un kullandığı Chromium disk önbelleği. Silmek güvenlidir, açılışta yeniden oluşur.";
"Claude Desktop and Claude CoWork store session state here. Deleting this is permanent — local sessions are not backed up to a server and do not come back." = "Claude Desktop ve Claude CoWork oturum durumunu burada saklar. Bunu silmek kalıcıdır — yerel oturumlar bir sunucuya yedeklenmez ve geri gelmez.";
"Codex HTTP cache only; task and account data are not targeted." = "Yalnızca Codex HTTP önbelleği; görev ve hesap verileri hedeflenmez.";
"Compiled package objects that make rebuilds fast (GOCACHE). Rebuilds itself — the first build after clearing is slower. Equivalent to go clean -cache." = "Yeniden derlemeleri hızlandıran derlenmiş paket nesneleri (GOCACHE). Kendini yeniden oluşturur — temizlikten sonraki ilk derleme daha yavaştır. go clean -cache ile aynı işi görür.";
"Content-addressable package store. Re-downloads on pnpm install." = "İçerik adresli paket deposu. pnpm install ile yeniden iner.";
"CoreSimulator dyld and framework caches. Rebuilds automatically." = "CoreSimulator dyld ve çerçeve önbellekleri. Otomatik olarak yeniden oluşur.";
"Cursor's whole application-support directory: workspace state, chat history, extensions and settings. Not a cache — deleting it is permanent." = "Cursor'ın tüm uygulama destek klasörü: çalışma alanı durumu, sohbet geçmişi, eklentiler ve ayarlar. Bu bir önbellek değildir — silmek kalıcıdır.";
"Debug symbols for connected iPhones/iPads. Re-downloads when device connects." = "Bağlanan iPhone/iPad'ler için hata ayıklama sembolleri. Aygıt bağlandığında yeniden iner.";
"Discord HTTP cache only." = "Yalnızca Discord HTTP önbelleği.";
"Discord's macOS-native temporary resource cache." = "Discord'un macOS'a özgü geçici kaynak önbelleği.";
"Disposable graphics cache only." = "Yalnızca gözden çıkarılabilir grafik önbelleği.";
"Docker images, containers, and volumes. May lose running containers and uncommitted data!" = "Docker imajları, konteynerleri ve birimleri. Çalışan konteynerleri ve kaydedilmemiş verileri kaybedebilirsiniz!";
"Downloaded AI/ML models, tokenizers, and datasets. Re-downloads on next use. Large models may take time." = "İndirilmiş yapay zekâ/makine öğrenmesi modelleri, tokenizer'lar ve veri kümeleri. Bir sonraki kullanımda yeniden iner. Büyük modeller zaman alabilir.";
"Downloaded Chromium binaries for Puppeteer. Re-downloads on npx puppeteer install." = "Puppeteer için indirilmiş Chromium ikili dosyaları. npx puppeteer install ile yeniden iner.";
"Downloaded Copilot CLI runtime versions and bundled dependencies. Local sessions, settings, plugins, and logs under ~/.copilot are not targeted." = "İndirilmiş Copilot CLI çalışma zamanı sürümleri ve paketlenmiş bağımlılıklar. ~/.copilot altındaki yerel oturumlar, ayarlar, eklentiler ve günlükler hedeflenmez.";
"Downloaded Firefox update payloads and updater state." = "İndirilmiş Firefox güncelleme paketleri ve güncelleyici durumu.";
"Downloaded JARs, build outputs, and wrapper dists. Re-downloads on gradle build." = "İndirilmiş JAR dosyaları, derleme çıktıları ve wrapper dağıtımları. gradle build ile yeniden iner.";
"Downloaded LLM model files. Re-downloads with ollama pull — large models take a while." = "İndirilmiş dil modeli dosyaları. ollama pull ile yeniden iner — büyük modeller zaman alır.";
"Downloaded Python wheels and sdists. Re-downloads on pip install." = "İndirilmiş Python wheel ve sdist paketleri. pip install ile yeniden iner.";
"Downloaded Sparkle update payloads and installer staging files." = "İndirilmiş Sparkle güncelleme paketleri ve kurulum hazırlık dosyaları.";
"Downloaded Swift packages. Re-downloads on next build (swift build)." = "İndirilmiş Swift paketleri. Bir sonraki derlemede (swift build) yeniden iner.";
"Downloaded browser binaries for Playwright testing. Re-downloads on npx playwright install." = "Playwright testleri için indirilmiş tarayıcı ikili dosyaları. npx playwright install ile yeniden iner.";
"Downloaded extension VSIX packages. Safe to delete, re-downloads when needed." = "İndirilmiş VSIX eklenti paketleri. Silmek güvenlidir, gerektiğinde yeniden iner.";
"Downloaded formula bottles and taps. Re-downloads on brew install." = "İndirilmiş formül şişeleri ve tap'ler. brew install ile yeniden iner.";
"Downloaded gem files. Rebuilds automatically with bundle install." = "İndirilmiş gem dosyaları. bundle install ile otomatik olarak yeniden oluşur.";
"Downloaded or staged Squirrel updater files." = "İndirilmiş veya hazırlanmış Squirrel güncelleyici dosyaları.";
"Downloaded pod specs and sources. Re-downloads on pod install." = "İndirilmiş pod tanımları ve kaynakları. pod install ile yeniden iner.";
"Electron/browser cache used by Unity Hub UI. Rebuilds automatically on next launch." = "Unity Hub arayüzünün kullandığı Electron/tarayıcı önbelleği. Bir sonraki açılışta otomatik olarak yeniden oluşur.";
"Emulator system images, one per API level and ABI. Re-download from Android Studio → SDK Manager. Often the largest part of the SDK." = "Öykünücü sistem imajları; her API düzeyi ve ABI için bir tane. Android Studio → SDK Manager üzerinden yeniden indirin. Çoğu zaman SDK'nın en büyük parçasıdır.";
"Firefox Developer Edition cache files only." = "Yalnızca Firefox Developer Edition önbellek dosyaları.";
"Firefox web, startup, thumbnail, and safe-browsing caches." = "Firefox web, başlangıç, küçük resim ve güvenli gezinme önbellekleri.";
"Generated JavaScript and WebAssembly cache only." = "Yalnızca üretilmiş JavaScript ve WebAssembly önbelleği.";
"Generated model preview images; source models are not targeted." = "Üretilmiş model önizleme görselleri; kaynak modeller hedeflenmez.";
"Generated model variants used for faster previews or compatibility." = "Daha hızlı önizleme veya uyumluluk için üretilmiş model varyantları.";
"Generated previews for assets; original asset files are not targeted." = "Varlıklar için üretilmiş önizlemeler; özgün varlık dosyaları hedeflenmez.";
"GitHub Desktop HTTP cache only; repositories are not targeted." = "Yalnızca GitHub Desktop HTTP önbelleği; depolar hedeflenmez.";
"Go module download cache. Re-downloads on go mod download." = "Go modül indirme önbelleği. go mod download ile yeniden iner.";
"Godot editor temp and shader cache. Rebuilds automatically on next launch." = "Godot düzenleyici geçici dosya ve gölgelendirici önbelleği. Bir sonraki açılışta otomatik olarak yeniden oluşur.";
"Godot export templates for each engine version. Re-download from Godot → Export → Manage Export Templates." = "Her motor sürümü için Godot dışa aktarma şablonları. Godot → Export → Manage Export Templates üzerinden yeniden indirin.";
"Gradle distribution binaries downloaded by wrapper scripts. Re-downloads on next gradle build." = "Wrapper betiklerinin indirdiği Gradle dağıtım dosyaları. Bir sonraki gradle build komutunda yeniden iner.";
"HTTP cache for Codex's isolated browser partition." = "Codex'in yalıtılmış tarayıcı bölümü için HTTP önbelleği.";
"IDE caches (IntelliJ, WebStorm, etc). Rebuilds on IDE restart." = "Geliştirme ortamı önbellekleri (IntelliJ, WebStorm vb.). Geliştirme ortamı yeniden başlatıldığında yeniden oluşur.";
"Installed Rust toolchains (stable, beta, nightly) — a full compiler and standard library each. Reinstall with rustup toolchain install." = "Kurulu Rust araç zincirleri (stable, beta, nightly) — her biri tam bir derleyici ve standart kütüphane. rustup toolchain install ile yeniden kurun.";
"Installed gems and docs. Reinstall with bundle install." = "Kurulu gem'ler ve belgeler. bundle install ile yeniden kurun.";
"Internal Xcode product caches. Rebuilds automatically on next build." = "Xcode'un iç ürün önbellekleri. Bir sonraki derlemede otomatik olarak yeniden oluşur.";
"Language runtimes installed by mise (Node, Python, Ruby, Go, etc.). Removing uninstalls them. Reinstall with mise install." = "mise tarafından kurulan dil çalışma zamanları (Node, Python, Ruby, Go vb.). Silmek bunları kaldırır. mise install ile yeniden kurun.";
"Local Maven repository (.m2). Re-downloads on mvn build." = "Yerel Maven deposu (.m2). mvn build ile yeniden iner.";
"Native Development Kit toolchains — a full compiler per installed version. Re-download from SDK Manager. Only needed for native (C/C++) Android builds." = "Native Development Kit araç zincirleri — kurulu her sürüm için tam bir derleyici. SDK Manager üzerinden yeniden indirin. Yalnızca yerel (C/C++) Android derlemeleri için gereklidir.";
"New Teams' macOS cache container." = "Yeni Teams'in macOS önbellek kapsayıcısı.";
"Node.js headers and libraries, one set per Node version, used to compile native addons. Re-downloads on the next native build." = "Yerel eklentileri derlemek için kullanılan Node.js başlıkları ve kütüphaneleri; her Node sürümü için bir takım. Bir sonraki yerel derlemede yeniden iner.";
"Node.js versions managed by nvm. Removing a version uninstalls it — reinstall with nvm install X.Y.Z." = "nvm tarafından yönetilen Node.js sürümleri. Bir sürümü silmek onu kaldırır — nvm install X.Y.Z ile yeniden kurun.";
"Notion HTTP cache only." = "Yalnızca Notion HTTP önbelleği.";
"Notion generated-code cache only." = "Yalnızca Notion üretilmiş kod önbelleği.";
"Notion graphics cache only." = "Yalnızca Notion grafik önbelleği.";
"Obsidian HTTP cache only; vaults and metadata storage are not targeted." = "Yalnızca Obsidian HTTP önbelleği; kasalar ve üstveri deposu hedeflenmez.";
"Obsidian generated-code cache only." = "Yalnızca Obsidian üretilmiş kod önbelleği.";
"Obsidian graphics cache only." = "Yalnızca Obsidian grafik önbelleği.";
"Old session logs and telemetry data. Safe to delete anytime." = "Eski oturum günlükleri ve telemetri verileri. İstediğiniz zaman silmek güvenlidir.";
"Pipenv virtual environments. Recreate with pipenv install." = "Pipenv sanal ortamları. pipenv install ile yeniden oluşturun.";
"Prisma ORM query engine binaries. Re-downloads on npx prisma generate." = "Prisma ORM sorgu motoru ikili dosyaları. npx prisma generate ile yeniden iner.";
"Python versions managed by pyenv. Removing uninstalls that version — reinstall with pyenv install X.Y.Z." = "pyenv tarafından yönetilen Python sürümleri. Silmek o sürümü kaldırır — pyenv install X.Y.Z ile yeniden kurun.";
"RVM rubies and gemsets. Reinstall with rvm install X.Y.Z." = "RVM Ruby sürümleri ve gem kümeleri. rvm install X.Y.Z ile yeniden kurun.";
"Raycast Store and API response cache. Clipboard history is explicitly excluded." = "Raycast Store ve API yanıt önbelleği. Pano geçmişi açıkça hariç tutulur.";
"Registry metadata and dlx cache, kept separately from the package store. Re-downloads on next pnpm install." = "Paket deposundan ayrı tutulan kayıt defteri üstverisi ve dlx önbelleği. Bir sonraki pnpm install komutunda yeniden iner.";
"Restored NuGet packages for .NET projects, one copy per package version. Re-downloads on dotnet restore." = ".NET projeleri için geri yüklenmiş NuGet paketleri; her paket sürümü için bir kopya. dotnet restore ile yeniden iner.";
"Ruby versions managed by mise. Reinstall with mise install ruby@X.Y.Z." = "mise tarafından yönetilen Ruby sürümleri. mise install ruby@X.Y.Z ile yeniden kurun.";
"Ruby versions managed by rbenv. Reinstall with rbenv install X.Y.Z." = "rbenv tarafından yönetilen Ruby sürümleri. rbenv install X.Y.Z ile yeniden kurun.";
"Safari's macOS cache container; website data is stored separately." = "Safari'nin macOS önbellek kapsayıcısı; web sitesi verileri ayrı saklanır.";
"Scala/Java dependencies cached by sbt and Ivy. Re-downloads on next sbt compile." = "sbt ve Ivy tarafından önbelleğe alınmış Scala/Java bağımlılıkları. Bir sonraki sbt compile komutunda yeniden iner.";
"Session transcripts, job state, file history, plugins and your settings. Almost none of this is a cache — deleting it permanently loses your Claude Code history." = "Oturum dökümleri, iş durumu, dosya geçmişi, eklentiler ve ayarlarınız. Bunların neredeyse hiçbiri önbellek değildir — silmek Claude Code geçmişinizi kalıcı olarak kaybettirir.";
"Signal HTTP cache only." = "Yalnızca Signal HTTP önbelleği.";
"Signal generated-code cache only." = "Yalnızca Signal üretilmiş kod önbelleği.";
"Signal graphics cache only." = "Yalnızca Signal grafik önbelleği.";
"Simulator crash reports and diagnostic logs. Safe to remove anytime." = "Simülatör çökme raporları ve tanılama günlükleri. İstediğiniz zaman silmek güvenlidir.";
"Slack App Store cache container." = "Slack App Store önbellek kapsayıcısı.";
"Slack HTTP cache only." = "Yalnızca Slack HTTP önbelleği.";
"Slack generated-code cache only." = "Yalnızca Slack üretilmiş kod önbelleği.";
"Slack graphics cache only." = "Yalnızca Slack grafik önbelleği.";
"Slack's macOS-native temporary resource cache." = "Slack'in macOS'a özgü geçici kaynak önbelleği.";
"Spotify helper-process cache." = "Spotify yardımcı süreç önbelleği.";
"Steam store, community, and library web-interface cache." = "Steam mağaza, topluluk ve kütüphane web arayüzü önbelleği.";
"Steam's alternate web-interface cache location." = "Steam'in alternatif web arayüzü önbellek konumu.";
"Streamed music and podcast cache; offline downloads are stored separately." = "Akış müzik ve podcast önbelleği; çevrimdışı indirmeler ayrı saklanır.";
"Stremio network cache; streams and account data are not targeted." = "Stremio ağ önbelleği; akışlar ve hesap verileri hedeflenmez.";
"SwiftUI preview simulator data. Rebuilds automatically on next preview." = "SwiftUI önizleme simülatörü verisi. Bir sonraki önizlemede otomatik olarak yeniden oluşur.";
"Terraform/OpenTofu CLI plugins and provider cache. Re-downloads on terraform init." = "Terraform/OpenTofu CLI eklentileri ve sağlayıcı önbelleği. terraform init ile yeniden iner.";
"Type definitions fetched automatically for JavaScript files (VS Code automatic type acquisition). Re-downloads when needed." = "JavaScript dosyaları için otomatik alınan tip tanımları (VS Code otomatik tip edinimi). Gerektiğinde yeniden iner.";
"Unity Asset Store downloaded packages. Re-downloads from Unity Package Manager." = "Unity Asset Store'dan indirilmiş paketler. Unity Package Manager üzerinden yeniden iner.";
"Unity Editor and player log files (crash reports, debug output). Safe to delete anytime." = "Unity Editor ve oynatıcı günlük dosyaları (çökme raporları, hata ayıklama çıktısı). İstediğiniz zaman silmek güvenlidir.";
"Unity build artifacts and shader compile cache. Rebuilds automatically on next build." = "Unity derleme çıktıları ve gölgelendirici derleme önbelleği. Bir sonraki derlemede otomatik olarak yeniden oluşur.";
"Unity project starter templates downloaded by Unity Hub. Re-download from Hub when needed. Can be 300MB+." = "Unity Hub tarafından indirilen Unity proje başlangıç şablonları. Gerektiğinde Hub üzerinden yeniden indirin. 300 MB'ı aşabilir.";
"VLC's macOS cache container." = "VLC'nin macOS önbellek kapsayıcısı.";
"VS Code application cache. Safe to delete, rebuilds automatically." = "VS Code uygulama önbelleği. Silmek güvenlidir, otomatik olarak yeniden oluşur.";
"VS Code compiled JavaScript cache. Safe to delete, recompiles on launch." = "VS Code derlenmiş JavaScript önbelleği. Silmek güvenlidir, açılışta yeniden derlenir.";
"Verified executables and archives downloaded by DotSlash. They are fetched again the next time a matching DotSlash launcher runs." = "DotSlash tarafından indirilen doğrulanmış çalıştırılabilir dosyalar ve arşivler. İlgili DotSlash başlatıcısı bir sonraki çalışmasında bunları yeniden indirir.";
"WhatsApp's sandbox cache container." = "WhatsApp'ın korumalı alan önbellek kapsayıcısı.";
"Windsurf's whole application-support directory: workspace state, chat history and settings. Not a cache — deleting it is permanent." = "Windsurf'ün tüm uygulama destek klasörü: çalışma alanı durumu, sohbet geçmişi ve ayarlar. Bu bir önbellek değildir — silmek kalıcıdır.";
"Zoom's macOS cache container." = "Zoom'un macOS önbellek kapsayıcısı.";
"iOS/watchOS/tvOS simulator devices and data. Re-download from Xcode → Settings." = "iOS/watchOS/tvOS simülatör aygıtları ve verileri. Xcode → Settings üzerinden yeniden indirin.";

/* MARK: Safety details */
"A downloaded or partially staged app update." = "İndirilmiş veya kısmen hazırlanmış bir uygulama güncellemesi.";
"Accounts, messages, cookies, local storage, settings, and documents." = "Hesaplar, mesajlar, çerezler, yerel depolama, ayarlar ve belgeler.";
"Cached browser responses used by Codex." = "Codex'in kullandığı önbelleğe alınmış tarayıcı yanıtları.";
"Cached copies of pages, images, scripts, generated code, and media." = "Sayfaların, görsellerin, betiklerin, üretilmiş kodun ve medyanın önbelleğe alınmış kopyaları.";
"Clipboard history, extensions, preferences, snippets, and account data." = "Pano geçmişi, eklentiler, tercihler, kod parçacıkları ve hesap verileri.";
"Codex tasks, accounts, settings, browser cookies, and downloaded files." = "Codex görevleri, hesaplar, ayarlar, tarayıcı çerezleri ve indirilen dosyalar.";
"Cookies, logins, passwords, bookmarks, history, extensions, profiles, and open tabs." = "Çerezler, oturumlar, parolalar, yer imleri, geçmiş, eklentiler, profiller ve açık sekmeler.";
"Derived model copies and their generated textures." = "Türetilmiş model kopyaları ve bunlara ait üretilmiş dokular.";
"Downloaded or partially staged Firefox update files." = "İndirilmiş veya kısmen hazırlanmış Firefox güncelleme dosyaları.";
"Everything this app currently stores in its designated cache container." = "Bu uygulamanın kendi önbellek kapsayıcısında şu anda sakladığı her şey.";
"Firefox, profiles, bookmarks, passwords, history, open tabs, and settings." = "Firefox, profiller, yer imleri, parolalar, geçmiş, açık sekmeler ve ayarlar.";
"Generated asset preview images." = "Üretilmiş varlık önizleme görselleri.";
"Generated model preview images." = "Üretilmiş model önizleme görselleri.";
"Only the listed HTTP, generated-code, network, or graphics cache directory." = "Yalnızca listelenen HTTP, üretilmiş kod, ağ veya grafik önbellek klasörü.";
"Original assets, projects, imported files, and app settings." = "Özgün varlıklar, projeler, içe aktarılmış dosyalar ve uygulama ayarları.";
"Original imported models, projects, and app settings." = "Özgün içe aktarılmış modeller, projeler ve uygulama ayarları.";
"Original models, textures, projects, and app settings." = "Özgün modeller, dokular, projeler ve uygulama ayarları.";
"Previously streamed temporary audio and artwork." = "Daha önce akışla alınmış geçici ses ve görseller.";
"Quit Codex first. Browser content may load more slowly once while the cache rebuilds." = "Önce Codex'ten çıkın. Önbellek yeniden oluşurken tarayıcı içeriği bir kereliğine daha yavaş yüklenebilir.";
"Quit Firefox first. Firefox may download the update again." = "Önce Firefox'tan çıkın. Firefox güncellemeyi yeniden indirebilir.";
"Quit Raycast first. ClearDisk never targets the sibling Clipboard folder." = "Önce Raycast'ten çıkın. ClearDisk yanındaki Clipboard klasörünü asla hedeflemez.";
"Quit Spotify first. Streamed content may use bandwidth again." = "Önce Spotify'dan çıkın. Akış içeriği yeniden bant genişliği kullanabilir.";
"Quit the app and review in Finder first; some apps misuse their cache container." = "Önce uygulamadan çıkıp Finder'da inceleyin; bazı uygulamalar önbellek kapsayıcısını amacı dışında kullanır.";
"Quit the app first so it can rebuild these files cleanly." = "Bu dosyaları temiz biçimde yeniden oluşturabilmesi için önce uygulamadan çıkın.";
"Quit the app first. Do not clean while an update is installing; the update may need to download again." = "Önce uygulamadan çıkın. Bir güncelleme kurulurken temizlik yapmayın; güncellemenin yeniden inmesi gerekebilir.";
"Quit the browser first. The first launch and first page loads may be slower." = "Önce tarayıcıdan çıkın. İlk açılış ve ilk sayfa yüklemeleri daha yavaş olabilir.";
"Raycast Store, API, and web-response cache." = "Raycast Store, API ve web yanıt önbelleği.";
"Review first: rebuilding adapted models may take time." = "Önce inceleyin: uyarlanmış modelleri yeniden oluşturmak zaman alabilir.";
"Review first: the app may need to download the update again." = "Önce inceleyin: uygulamanın güncellemeyi yeniden indirmesi gerekebilir.";
"Review in Finder first. Some apps misuse cache folders, so this is never auto-selected." = "Önce Finder'da inceleyin. Bazı uygulamalar önbellek klasörlerini amacı dışında kullandığı için bu asla otomatik seçilmez.";
"Temporary resources stored in the app's macOS cache container." = "Uygulamanın macOS önbellek kapsayıcısında saklanan geçici kaynaklar.";
"The app bundle, Documents, and Application Support locations are not targeted." = "Uygulama paketi, Belgeler ve Application Support konumları hedeflenmez.";
"The app may regenerate model thumbnails on demand." = "Uygulama model küçük resimlerini gerektiğinde yeniden üretebilir.";
"The app may regenerate thumbnails the next time those assets are viewed." = "Uygulama, bu varlıklar bir sonraki görüntülenişinde küçük resimleri yeniden üretebilir.";
"The currently installed app, its settings, accounts, and documents." = "Hâlihazırda kurulu uygulama, ayarları, hesapları ve belgeleri.";
"The downloaded update payload, staging copy, updater state, and updater logs." = "İndirilen güncelleme paketi, hazırlık kopyası, güncelleyici durumu ve güncelleyici günlükleri.";
"The installed app, its settings, accounts, and documents." = "Kurulu uygulama, ayarları, hesapları ve belgeleri.";
"Your account, playlists, local files, and explicitly downloaded offline library." = "Hesabınız, çalma listeleriniz, yerel dosyalarınız ve bilerek indirdiğiniz çevrimdışı kitaplığınız.";
